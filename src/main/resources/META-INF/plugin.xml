<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin url="https://github.com/wanjas/pnpm-catalog-completions">
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.github.wanjas.pnpmcatalogcompletions</id>

    <name>pnpm Catalog Completions</name>

    <vendor url="https://github.com/wanjas">wanjas</vendor>

    <description><![CDATA[
        Adds npm version code completion to <b>pnpm catalogs</b>.<br>
        <br>
        In <code>pnpm-workspace.yaml</code>, invoke code completion on the version of any entry under
        <code>catalog:</code> or <code>catalogs:</code> and get the list of versions published to the
        npm registry &mdash; exactly the completion the IDE already offers for
        <code>package.json</code> dependencies, including <code>^</code>/<code>~</code> range
        variants and distribution tags.<br>
        <br>
        <pre>
catalog:
  react: ^18.3.1
catalogs:
  react17:
    react: ^17.0.2
        </pre>
        Versions come from the same npm registry service the IDE uses for
        <code>package.json</code>, so custom registries configured in <code>.npmrc</code> are honored.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!-- YAML PSI for pnpm-workspace.yaml. -->
    <depends>org.jetbrains.plugins.yaml</depends>
    <!-- NpmRegistryService. Implies com.intellij.modules.ultimate, so this plugin is for
         IDEA Ultimate / WebStorm / PhpStorm / etc., not IDEA Community. -->
    <depends>JavaScript</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor language="yaml"
                                implementationClass="com.github.wanjas.pnpmcatalogcompletions.PnpmCatalogVersionCompletionContributor"/>
        <lookup.charFilter implementation="com.github.wanjas.pnpmcatalogcompletions.PnpmCatalogCharFilter"/>
        <typedHandler implementation="com.github.wanjas.pnpmcatalogcompletions.PnpmCatalogTypedHandler"/>
    </extensions>
</idea-plugin>
